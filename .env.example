# ── Speech-To-Text ────────────────────────────────────────────────────────────
SARVAM_API_KEY=your_sarvam_key
SARVAM_API_KEYS=key1,key2,key3,key4
DEEPGRAM_API_KEY=your_deepgram_key

STT_MAX_CONCURRENT=10
STT_DEFAULT_CLIENT_MAX_CONCURRENT=3
STT_DEFAULT_CLIENT_MAX_RPS=4
SARVAM_API_RPM_LIMIT=110
STT_ONLY_SILENCE_MS=450
STT_ONLY_RMS_SPEECH=100
STT_ONLY_MIN_AUDIO_MS=200

# ── LLM (Groq) ────────────────────────────────────────────────────────────────
GROQ_API_KEY=your_groq_key
GROQ_API_KEYS=key1,key2,key3

LLM_MAX_CONCURRENT_PER_KEY=5
LLM_MAX_RETRIES=2
LLM_RETRY_DELAY_SEC=0.3
LLM_MODEL=llama-3.3-70b-versatile

# ── Text-To-Speech ────────────────────────────────────────────────────────────
CARTESIA_API_KEY=your_cartesia_key
CARTESIA_API_KEYS=key1,key2,key3,key4
CARTESIA_VOICE_ID=your_voice_id
ELEVENLABS_API_KEY=your_elevenlabs_key
ELEVENLABS_VOICE_ID=your_voice_id

# ── Vobiz Telephony ───────────────────────────────────────────────────────────
VOBIZ_AUTH_ID=your_vobiz_auth_id
VOBIZ_AUTH_TOKEN=your_vobiz_auth_token
VOBIZ_API_BASE=https://api.vobiz.ai/api/v1

# ── Server / Ngrok ────────────────────────────────────────────────────────────
SERVER_BASE_URL=https://your-ngrok-or-server-url.ngrok-free.app

# ── Database (PostgreSQL via Docker) ──────────────────────────────────────────
DATABASE_URL=postgresql://khyra:khyra_secret@localhost:5432/khyra_db

# ── N8N Webhook ───────────────────────────────────────────────────────────────
N8N_WEBHOOK_URL=https://your-n8n-instance.ngrok-free.app/webhook/your-webhook-id

# ── Client DID mapping ────────────────────────────────────────────────────────
CLIENT_PHONE_MAP_JSON={"+91XXXXXXXXXX": "your_client_id"}
